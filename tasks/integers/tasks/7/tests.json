{
  "version": 1,
  "kind": "io",
  "contract": "Ввод: одна десятичная запись неотрицательного числа (до 10 цифр), без ведущих нулей, кроме 0. Вывод: результат без подписей; предикат 1/0. Позиции нумеруются слева с 1. Списки выводятся через пробел; пустой список — пустой вывод. Результат преобразования записи сохраняет ведущие нули. Для удаления всех цифр выводится 0. Дополнение вычисляется в ширине входной записи; ноль остаётся нулём.",
  "cases": [
    {
      "name": "case_1",
      "input": "0\n",
      "expected": "0\n"
    },
    {
      "name": "case_2",
      "input": "7\n",
      "expected": "3\n"
    },
    {
      "name": "case_3",
      "input": "10\n",
      "expected": "90\n"
    },
    {
      "name": "case_4",
      "input": "11\n",
      "expected": "89\n"
    },
    {
      "name": "case_5",
      "input": "101\n",
      "expected": "899\n"
    },
    {
      "name": "case_6",
      "input": "1234\n",
      "expected": "8766\n"
    },
    {
      "name": "case_7",
      "input": "1001\n",
      "expected": "8999\n"
    },
    {
      "name": "case_8",
      "input": "987654\n",
      "expected": "012346\n"
    },
    {
      "name": "case_9",
      "input": "112233\n",
      "expected": "887767\n"
    },
    {
      "name": "case_10",
      "input": "1234567890\n",
      "expected": "8765432110\n"
    }
  ]
}
