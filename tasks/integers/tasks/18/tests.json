{
  "version": 1,
  "kind": "io",
  "contract": "Ввод: одна десятичная запись неотрицательного числа (до 10 цифр), без ведущих нулей, кроме 0. Вывод: результат без подписей; предикат 1/0. Позиции нумеруются слева с 1. Списки выводятся через пробел; пустой список — пустой вывод. Результат преобразования записи сохраняет ведущие нули. Для удаления всех цифр выводится 0.",
  "cases": [
    {
      "name": "case_1",
      "input": "10\n",
      "expected": "01\n"
    },
    {
      "name": "case_2",
      "input": "11\n",
      "expected": "11\n"
    },
    {
      "name": "case_3",
      "input": "101\n",
      "expected": "101\n"
    },
    {
      "name": "case_4",
      "input": "1234\n",
      "expected": "1324\n"
    },
    {
      "name": "case_5",
      "input": "1001\n",
      "expected": "1001\n"
    },
    {
      "name": "case_6",
      "input": "987654\n",
      "expected": "957684\n"
    },
    {
      "name": "case_7",
      "input": "112233\n",
      "expected": "132213\n"
    },
    {
      "name": "case_8",
      "input": "1234567890\n",
      "expected": "1934567820\n"
    }
  ]
}
