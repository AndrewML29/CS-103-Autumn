{
  "version": 1,
  "kind": "io",
  "contract": "Ввод: одна десятичная запись неотрицательного числа (до 10 цифр), без ведущих нулей, кроме 0. Вывод: результат без подписей; предикат 1/0. Позиции нумеруются слева с 1. Списки выводятся через пробел; пустой список — пустой вывод. Результат преобразования записи сохраняет ведущие нули. Для удаления всех цифр выводится 0. На каждую цифру вывести отдельный двухзначный восьмеричный код.",
  "cases": [
    {
      "name": "case_1",
      "input": "0\n",
      "expected": "00\n"
    },
    {
      "name": "case_2",
      "input": "7\n",
      "expected": "07\n"
    },
    {
      "name": "case_3",
      "input": "10\n",
      "expected": "01 00\n"
    },
    {
      "name": "case_4",
      "input": "11\n",
      "expected": "01 01\n"
    },
    {
      "name": "case_5",
      "input": "101\n",
      "expected": "01 00 01\n"
    },
    {
      "name": "case_6",
      "input": "1234\n",
      "expected": "01 02 03 04\n"
    },
    {
      "name": "case_7",
      "input": "1001\n",
      "expected": "01 00 00 01\n"
    },
    {
      "name": "case_8",
      "input": "987654\n",
      "expected": "11 10 07 06 05 04\n"
    },
    {
      "name": "case_9",
      "input": "112233\n",
      "expected": "01 01 02 02 03 03\n"
    },
    {
      "name": "case_10",
      "input": "1234567890\n",
      "expected": "01 02 03 04 05 06 07 10 11 00\n"
    }
  ]
}
