{
  "version": 1,
  "kind": "shell",
  "contract": "Каждый *.bash запускается отдельно в новом временном каталоге. Имена входных файлов и ожидаемое состояние заданы setup/checks. Для поиска и ранжирования выводить только имена файлов, для номеров строк — только номера, для пароля — только пароль. Если в исходном условии нет имени файла, используется input.txt (для chmod — run.py). Размеры в MiB. chmod проверяется по точной восьмеричной маске. Учитываются только созданные тестом файлы.",
  "cases": [
    {
      "name": "script_1",
      "script": "1.bash",
      "setup": [
        {
          "path": "file1.c",
          "type": "file",
          "content": "code"
        }
      ],
      "checks": [
        {
          "path": "file0.c",
          "content": "code"
        },
        {
          "path": "file1.c",
          "absent": true
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_2",
      "script": "2.bash",
      "setup": [],
      "checks": [
        {
          "path": "Turing/Markov/ZZZ",
          "type": "directory"
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_3",
      "script": "3.bash",
      "setup": [
        {
          "path": "run.py",
          "type": "file",
          "content": "",
          "mode": "000"
        }
      ],
      "checks": [
        {
          "path": "run.py",
          "mode": "764"
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_4",
      "script": "4.bash",
      "setup": [
        {
          "path": "aba.py",
          "type": "file",
          "content": ""
        },
        {
          "path": "aba_test.py",
          "type": "file",
          "content": ""
        },
        {
          "path": "other.py",
          "type": "file",
          "content": "keep"
        },
        {
          "path": "aba.txt",
          "type": "file",
          "content": "keep"
        }
      ],
      "checks": [
        {
          "path": "aba.py",
          "absent": true
        },
        {
          "path": "aba_test.py",
          "absent": true
        },
        {
          "path": "other.py",
          "content": "keep"
        },
        {
          "path": "aba.txt",
          "content": "keep"
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_5",
      "script": "5.bash",
      "setup": [
        {
          "path": "ty.go",
          "type": "file",
          "content": "code"
        },
        {
          "path": "golangCode/main.go",
          "type": "file",
          "content": "code"
        }
      ],
      "checks": [],
      "cwd": ".",
      "manual": "В исходном условии отсутствует назначение копирования файла и каталога. Уточнить путь назначения."
    },
    {
      "name": "script_6",
      "script": "6.bash",
      "setup": [
        {
          "path": "virus.py",
          "type": "file",
          "content": "pass",
          "mode": "777"
        }
      ],
      "checks": [
        {
          "path": "virus.py",
          "mode": "666"
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_7",
      "script": "7.bash",
      "setup": [
        {
          "path": "a.sh",
          "type": "file",
          "content": "",
          "mode": "777"
        },
        {
          "path": "b.sh",
          "type": "file",
          "content": "",
          "mode": "755"
        },
        {
          "path": "c.txt",
          "type": "file",
          "content": "",
          "mode": "777"
        }
      ],
      "checks": [],
      "cwd": ".",
      "paths": true,
      "expected": "a.sh"
    },
    {
      "name": "script_8",
      "script": "8.bash",
      "setup": [
        {
          "path": "a.sh",
          "type": "file",
          "content": "",
          "mode": "755"
        },
        {
          "path": "b.bin",
          "type": "file",
          "content": "",
          "mode": "700"
        },
        {
          "path": "c.txt",
          "type": "file",
          "content": "",
          "mode": "644"
        },
        {
          "path": "dir",
          "type": "directory"
        }
      ],
      "checks": [],
      "cwd": ".",
      "paths": true,
      "unordered": true,
      "expected": "a.sh b.bin"
    },
    {
      "name": "script_9",
      "script": "9.bash",
      "setup": [
        {
          "path": ".a",
          "type": "file",
          "content": ""
        },
        {
          "path": "d/.b",
          "type": "file",
          "content": ""
        },
        {
          "path": "d/e/.c",
          "type": "file",
          "content": ""
        },
        {
          "path": "d/e/f/.deep",
          "type": "file",
          "content": ""
        },
        {
          "path": "visible",
          "type": "file",
          "content": ""
        }
      ],
      "checks": [],
      "cwd": ".",
      "paths": true,
      "unordered": true,
      "expected": ".a d/.b d/e/.c"
    },
    {
      "name": "script_10",
      "script": "10.bash",
      "setup": [
        {
          "path": "apple.txt",
          "type": "file",
          "content": ""
        },
        {
          "path": "abc",
          "type": "file",
          "content": ""
        },
        {
          "path": "a.php",
          "type": "file",
          "content": ""
        },
        {
          "path": "beta",
          "type": "file",
          "content": ""
        }
      ],
      "checks": [],
      "cwd": ".",
      "paths": true,
      "unordered": true,
      "expected": "abc apple.txt"
    }
  ]
}
