        {
          "path": "КИНО_Кукушка.mp3",
          "type": "file",
          "content": ""
        },
        {
          "path": "КИНО_Звезда_ReMiX.mp3",
          "type": "file",
          "content": ""
        }
      ],
      "checks": [],
