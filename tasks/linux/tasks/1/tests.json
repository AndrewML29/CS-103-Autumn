    {
      "name": "script_1",
      "script": "1.bash",
      "setup": [],
      "checks": [
        {
          "path": "MAI",
          "type": "directory"
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_2",
      "script": "2.bash",
      "setup": [
        {
          "path": "file1.txt",
          "type": "file",
          "content": "alpha\n"
        },
        {
          "path": "file2.txt",
          "type": "file",
          "content": "beta\n"
        }
      ],
      "checks": [
        {
          "path": "file3.txt",
          "content": "alpha\nbeta\n"
        },
        {
          "path": "file1.txt",
          "content": "alpha\n"
        },
        {
          "path": "file2.txt",
          "content": "beta\n"
        }
      ],
      "cwd": "."
    },
    {
      "name": "script_3",
      "script": "3.bash",
      "setup": [
        {
          "path": "NotEmpty.txt",
          "type": "file",
          "content": "alpha\n\nbeta\n\n"
        }
      ],
      "checks": [],
      "cwd": ".",
      "expected": "alpha\nbeta\n"
    },
